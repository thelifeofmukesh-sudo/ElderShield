# GEMINI_API_KEY: Required for Gemini AI API calls if optional AI tools are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# ==============================================================================
# OPTIONAL PRODUCTION BACKEND (SUPABASE + RESEND)
# Leave blank to run in clearly labelled Local Demonstration Mode.
# ==============================================================================
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Server-only secrets (NEVER prefix with VITE_ or expose in frontend code)
SUPABASE_SERVICE_ROLE_KEY=""
RESEND_API_KEY=""
RESEND_FROM_EMAIL="ElderShield Care <notifications@example.com>"
INVITATION_HMAC_SECRET="replace-with-random-32-byte-secret"
